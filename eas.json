        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_LONAGRAM_API_URL": "https://lonagram.com",
        "EXPO_PUBLIC_SUPABASE_URL": "https://tuuancbntarycnodwmpb.supabase.co"
