{
  "expo": {
    "name": "Lonagram",
    "slug": "lonagram",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-ios-1024.png",
    "scheme": "lonagram",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.lonagram.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/brand/icon-ios-1024.png",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.lonagram.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/brand/icon-android-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/brand/lonagram-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8FF",
          "image": "./assets/brand/lonagram-mark.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#17122B"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lonagram uses your selected photo as your profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
