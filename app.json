{
  "expo": {
    "name": "Lonagram",
    "slug": "lonagram",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-512.png",
    "scheme": "lonagram",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.lonagram.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.lonagram.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/brand/icon-512.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/lonagram-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/brand/lonagram-mark.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
