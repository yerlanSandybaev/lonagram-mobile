diff --git a/src/app/api/mobile/v1/route.ts b/src/app/api/mobile/v1/route.ts
new file mode 100644
--- /dev/null
+++ b/src/app/api/mobile/v1/route.ts
@@ -0,0 +1,88 @@
+import "server-only";
+import { createClient } from "@supabase/supabase-js";
+import { getEnv } from "@/lib/env";
+import { createAppServices } from "@/server/runtime";
+import { mobileHandler, type MobileLedger } from "@/server/mobile-handler";
+
+export const runtime = "nodejs";
+export async function POST(request: Request) {
+  const env = getEnv();
+  // Never fall back to the demo store or a browser-cookie client here.
+  if (
+    !env.supabaseConfigured ||
+    !env.supabaseUrl ||
+    !env.supabaseAnonKey ||
+    !env.supabaseServiceRoleKey
+  ) {
+    return Response.json(
+      {
+        ok: false,
+        error: "Mobile access is not configured.",
+        code: "configuration",
+      },
+      { status: 503, headers: { "Cache-Control": "no-store" } },
+    );
+  }
+  const auth = createClient(env.supabaseUrl, env.supabaseAnonKey, {
+    auth: { persistSession: false, autoRefreshToken: false },
+  });
+  const admin = createClient(env.supabaseUrl, env.supabaseServiceRoleKey, {
+    auth: { persistSession: false, autoRefreshToken: false },
+  });
+  const ledger: MobileLedger = {
+    async reserve(actor, operation, key, hash) {
+      const inserted = await admin
+        .from("mobile_requests")
+        .insert({
+          actor_id: actor,
+          operation,
+          request_key: key,
+          input_hash: hash,
+          state: "pending",
+        });
+      if (!inserted.error) return { kind: "new" };
+      if (inserted.error.code !== "23505")
+        throw new Error("ledger unavailable");
+      const prior = await admin
+        .from("mobile_requests")
+        .select("input_hash,state,result")
+        .eq("actor_id", actor)
+        .eq("operation", operation)
+        .eq("request_key", key)
+        .single();
+      if (prior.error) throw new Error("ledger unavailable");
+      if (prior.data.input_hash !== hash) return { kind: "conflict" };
+      return prior.data.state === "complete"
+        ? { kind: "replay", result: prior.data.result }
+        : { kind: "pending" };
+    },
+    async finish(actor, operation, key, result) {
+      const saved = await admin
+        .from("mobile_requests")
+        .update({ state: "complete", result })
+        .eq("actor_id", actor)
+        .eq("operation", operation)
+        .eq("request_key", key)
+        .select("request_key")
+        .single();
+      if (saved.error) throw new Error("ledger unavailable");
+    },
+  };
+  return mobileHandler({
+    verify: async (token) => {
+      const { data, error } = await auth.auth.getUser(token);
+      return error ? null : (data.user?.id ?? null);
+    },
+    services: createAppServices,
+    ledger,
+    beforeDelete: async (token, actor) => {
+      const revoked = await admin.auth.admin.signOut(token, "global");
+      if (revoked.error) throw revoked.error;
+      const cleared = await admin
+        .from("mobile_requests")
+        .delete()
+        .eq("actor_id", actor);
+      if (cleared.error) throw cleared.error;
+    },
+  })(request);
+}
diff --git a/src/server/mobile-contract.ts b/src/server/mobile-contract.ts
new file mode 100644
--- /dev/null
+++ b/src/server/mobile-contract.ts
@@ -0,0 +1,268 @@
+import { z } from "zod";
+import type { Services } from "@/domain/service";
+import {
+  onboardingSchema,
+  permissionSchema,
+  datingPreferencesSchema,
+  reportSchema,
+} from "@/domain/schemas";
+import { twinTimelineLine } from "@/domain/twin-inbox";
+
+const none = z.object({}).strict();
+const uuid = z.uuid();
+const other = z.object({ otherId: uuid }).strict();
+const thread = z.object({ conversationId: uuid }).strict();
+const permissionsPatch = permissionSchema.partial().strict();
+const profilePatch = onboardingSchema
+  .pick({
+    username: true,
+    displayName: true,
+    bio: true,
+    avatarUrl: true,
+    city: true,
+    languages: true,
+    intentions: true,
+  })
+  .strict();
+const twinPatch = onboardingSchema
+  .pick({
+    personality: true,
+    topics: true,
+    lookingFor: true,
+    communicationStyle: true,
+    hobbies: true,
+    interestingConversation: true,
+    publicIntroduction: true,
+  })
+  .extend({ enabled: z.boolean() })
+  .strict();
+
+export const mobileSchemas = {
+  "settings.get": none,
+  "home.get": none,
+  "dating.get": none,
+  "dating.discover": none,
+  "dating.update": z.object({ preferences: datingPreferencesSchema }).strict(),
+  "dating.like": other,
+  "onboarding.complete": onboardingSchema.strict(),
+  "profile.update": z
+    .object({
+      profile: profilePatch,
+      interests: onboardingSchema.shape.interests,
+    })
+    .strict(),
+  "twin.update": z.object({ twin: twinPatch }).strict(),
+  "permissions.update": z.object({ permissions: permissionsPatch }).strict(),
+  "twin.start": other,
+  "twin.get": thread,
+  "twin.list": none,
+  "twin.turn": thread
+    .extend({ cue: z.string().trim().min(1).max(2000) })
+    .strict(),
+  "twin.inbox": thread.extend({ lastSeenId: uuid }).strict(),
+  "connection.request": other
+    .extend({
+      source: z.enum(["discover", "twin_chat"]),
+      twinId: uuid.optional(),
+    })
+    .strict(),
+  "connection.respond": z
+    .object({
+      requestId: uuid,
+      decision: z.enum(["accepted", "rejected", "ignored"]),
+    })
+    .strict(),
+  "messages.list": none,
+  "messages.get": thread,
+  "messages.send": thread
+    .extend({ body: z.string().trim().min(1).max(2000) })
+    .strict(),
+  "notifications.list": none,
+  "notifications.read": z.object({ id: uuid }).strict(),
+  "notifications.readAll": none,
+  "unread.get": none,
+  "safety.block": other,
+  "safety.unblock": other,
+  "safety.report": reportSchema.strict(),
+  "account.delete": z
+    .object({ username: z.string().trim().min(3).max(20) })
+    .strict(),
+} as const;
+export type MobileOperation = keyof typeof mobileSchemas;
+export const guardedOperations = new Set<MobileOperation>([
+  "dating.like",
+  "twin.start",
+  "twin.turn",
+  "connection.request",
+  "connection.respond",
+  "messages.send",
+  "safety.report",
+]);
+
+// Explicit dispatch only. This endpoint never exposes arbitrary service/RPC methods.
+export async function dispatchMobile(
+  services: Services,
+  actor: string,
+  operation: MobileOperation,
+  raw: unknown,
+) {
+  const parse = <T extends MobileOperation>(name: T) =>
+    mobileSchemas[name].parse(raw) as z.infer<(typeof mobileSchemas)[T]>;
+  switch (operation) {
+    case "settings.get":
+      return services.getSettings(actor);
+    case "home.get":
+      return services.getHome(actor);
+    case "dating.get":
+      return services.getDating(actor);
+    case "dating.discover":
+      return services.discover(actor, { filter: "dating", limit: 24 });
+    case "dating.update":
+      return services.saveDatingPreferences(
+        actor,
+        parse(operation).preferences,
+      );
+    case "dating.like":
+      return services.likeDatingProfile(actor, parse(operation).otherId);
+    case "onboarding.complete":
+      return services.completeOnboarding(actor, {
+        ...parse(operation),
+        publishTwin: parse(operation).publishTwin ?? false,
+      });
+    case "profile.update": {
+      const value = parse(operation);
+      const current = await services.getSettings(actor);
+      if (!current.ok) return current;
+      if (!current.data.profile.onboardingComplete)
+        return {
+          ok: false as const,
+          error: "Complete onboarding first.",
+          code: "onboarding",
+        };
+      return services.completeOnboarding(actor, {
+        ...current.data.twin,
+        ...current.data.profile,
+        ...value.profile,
+        interests: value.interests,
+        permissions: current.data.permissions,
+      });
+    }
+    case "twin.update": {
+      const value = parse(operation);
+      const current = await services.getSettings(actor);
+      if (!current.ok) return current;
+      const result = await services.completeOnboarding(actor, {
+        ...current.data.profile,
+        ...current.data.twin,
+        ...value.twin,
+        interests: current.data.interests,
+        permissions: current.data.permissions,
+        publishTwin: false,
+      });
+      return result.ok
+        ? services.setTwinEnabled(actor, value.twin.enabled)
+        : result;
+    }
+    case "permissions.update": {
+      const current = await services.getSettings(actor);
+      if (!current.ok) return current;
+      return services.updatePermissions(actor, {
+        ...current.data.permissions,
+        ...parse(operation).permissions,
+      });
+    }
+    case "twin.start":
+      return services.startTwinConversation(actor, parse(operation).otherId);
+    case "twin.get": {
+      const result = await services.getTwinThread(
+        actor,
+        parse(operation).conversationId,
+      );
+      return result.ok
+        ? {
+            ok: true as const,
+            data: {
+              ...result.data,
+              messages: result.data.messages.map((message) => {
+                const line = twinTimelineLine(message);
+                return {
+                  id: message.id,
+                  speakerUserId: message.speakerUserId,
+                  body: line.text,
+                  fromPerson: line.fromPerson,
+                  personalKind: message.personalKind,
+                  createdAt: message.createdAt,
+                };
+              }),
+            },
+          }
+        : result;
+    }
+    case "twin.list":
+      return services.listTwinThreads(actor);
+    case "twin.turn": {
+      const value = parse(operation);
+      return services.runTurn(actor, value.conversationId, value.cue);
+    }
+    case "twin.inbox": {
+      const value = parse(operation);
+      return services.updateTwinInbox(actor, value.conversationId, {
+        lastSeenId: value.lastSeenId,
+      });
+    }
+    case "connection.request": {
+      const value = parse(operation);
+      return services.requestConnection(
+        actor,
+        value.otherId,
+        value.source,
+        value.twinId ?? null,
+        false,
+      );
+    }
+    case "connection.respond": {
+      const value = parse(operation);
+      return services.respondConnection(actor, value.requestId, value.decision);
+    }
+    case "messages.list":
+      return services.listDirectThreads(actor);
+    case "messages.get":
+      return services.getDirectThread(actor, parse(operation).conversationId);
+    case "messages.send": {
+      const value = parse(operation);
+      return services.sendDirectMessage(
+        actor,
+        value.conversationId,
+        value.body,
+      );
+    }
+    case "notifications.list":
+      return services.listNotifications(actor);
+    case "notifications.read":
+      return services.markNotificationRead(actor, parse(operation).id);
+    case "notifications.readAll":
+      return services.markAllNotificationsRead(actor);
+    case "unread.get":
+      return services.counts(actor);
+    case "safety.block":
+      return services.blockUser(actor, parse(operation).otherId);
+    case "safety.unblock":
+      return services.unblockUser(actor, parse(operation).otherId);
+    case "safety.report":
+      return services.report(actor, parse(operation));
+    case "account.delete": {
+      const current = await services.getSettings(actor);
+      if (!current.ok) return current;
+      if (
+        parse(operation).username.toLowerCase() !==
+        current.data.profile.username
+      )
+        return {
+          ok: false as const,
+          error: "Type your username to confirm.",
+          code: "validation",
+        };
+      return services.deleteAccount(actor);
+    }
+  }
+}
diff --git a/src/server/mobile-handler.ts b/src/server/mobile-handler.ts
new file mode 100644
--- /dev/null
+++ b/src/server/mobile-handler.ts
@@ -0,0 +1,217 @@
+import { createHash } from "node:crypto";
+import { z } from "zod";
+import type { Services } from "@/domain/service";
+import {
+  dispatchMobile,
+  guardedOperations,
+  mobileSchemas,
+  type MobileOperation,
+} from "@/server/mobile-contract";
+
+type Result = { ok: boolean; data?: unknown; error?: string; code?: string };
+export type Reservation =
+  | { kind: "new" }
+  | { kind: "pending" | "conflict" }
+  | { kind: "replay"; result: Result };
+export type MobileLedger = {
+  reserve: (
+    actor: string,
+    operation: string,
+    key: string,
+    hash: string,
+  ) => Promise<Reservation>;
+  finish: (
+    actor: string,
+    operation: string,
+    key: string,
+    result: Result,
+  ) => Promise<void>;
+};
+const envelope = z
+  .object({ operation: z.string(), input: z.unknown() })
+  .strict();
+function reply(result: Result, status?: number) {
+  const code = result.code ?? "";
+  const inferred = result.ok
+    ? 200
+    : code.includes("rate")
+      ? 429
+      : code === "not_found"
+        ? 404
+        : ["blocked", "forbidden"].includes(code)
+          ? 403
+          : 400;
+  return Response.json(result, {
+    status: status ?? inferred,
+    headers: { "Cache-Control": "private, no-store", Vary: "Authorization" },
+  });
+}
+async function boundedJson(request: Request) {
+  const reader = request.body?.getReader();
+  if (!reader) throw new Error("body");
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  try {
+    while (true) {
+      const part = await reader.read();
+      if (part.done) break;
+      size += part.value.byteLength;
+      if (size > 250_000) {
+        await reader.cancel();
+        throw new Error("size");
+      }
+      chunks.push(part.value);
+    }
+  } finally {
+    reader.releaseLock();
+  }
+  const bytes = new Uint8Array(size);
+  let offset = 0;
+  for (const chunk of chunks) {
+    bytes.set(chunk, offset);
+    offset += chunk.length;
+  }
+  return JSON.parse(new TextDecoder().decode(bytes));
+}
+export function mobileHandler(deps: {
+  verify: (token: string) => Promise<string | null>;
+  services: () => Services;
+  ledger: MobileLedger;
+  beforeDelete?: (token: string, actor: string) => Promise<void>;
+}) {
+  return async (request: Request) => {
+    const token = /^Bearer ([^\s]+)$/.exec(
+      request.headers.get("Authorization") ?? "",
+    )?.[1];
+    if (!token)
+      return reply(
+        { ok: false, error: "Sign in required.", code: "unauthenticated" },
+        401,
+      );
+    let actor: string | null;
+    try {
+      actor = await deps.verify(token);
+    } catch {
+      return reply(
+        {
+          ok: false,
+          error: "Authentication unavailable.",
+          code: "auth_unavailable",
+        },
+        503,
+      );
+    }
+    if (!actor)
+      return reply(
+        { ok: false, error: "Sign in required.", code: "unauthenticated" },
+        401,
+      );
+    if (!request.headers.get("content-type")?.includes("application/json"))
+      return reply(
+        { ok: false, error: "JSON required.", code: "validation" },
+        415,
+      );
+    let body: z.infer<typeof envelope>;
+    try {
+      body = envelope.parse(await boundedJson(request));
+    } catch {
+      return reply(
+        {
+          ok: false,
+          error: "Invalid or oversized request.",
+          code: "validation",
+        },
+        400,
+      );
+    }
+    if (!Object.hasOwn(mobileSchemas, body.operation))
+      return reply(
+        { ok: false, error: "Unknown operation.", code: "validation" },
+        400,
+      );
+    const operation = body.operation as MobileOperation;
+    const parsed = mobileSchemas[operation].safeParse(body.input);
+    if (!parsed.success)
+      return reply(
+        {
+          ok: false,
+          error: parsed.error.issues[0]?.message ?? "Check your input.",
+          code: "validation",
+        },
+        400,
+      );
+    const key = request.headers.get("Idempotency-Key");
+    const guarded = guardedOperations.has(operation);
+    if (guarded && (!key || !/^[a-zA-Z0-9:_-]{8,200}$/.test(key)))
+      return reply(
+        {
+          ok: false,
+          error: "A valid request key is required.",
+          code: "idempotency",
+        },
+        400,
+      );
+    try {
+      if (guarded && key) {
+        const hash = createHash("sha256")
+          .update(JSON.stringify(parsed.data))
+          .digest("hex");
+        const reservation = await deps.ledger.reserve(
+          actor,
+          operation,
+          key,
+          hash,
+        );
+        if (reservation.kind === "replay") return reply(reservation.result);
+        if (reservation.kind !== "new")
+          return reply(
+            {
+              ok: false,
+              error:
+                reservation.kind === "pending"
+                  ? "This request is still being checked. Retry the same draft later."
+                  : "This request key belongs to different content.",
+              code: reservation.kind,
+            },
+            409,
+          );
+      }
+      if (operation === "account.delete" && deps.beforeDelete) {
+        // Validate ownership/confirmation before revoking sessions.
+        const settings = await deps.services().getSettings(actor);
+        if (!settings.ok) return reply(settings);
+        if (
+          (parsed.data as { username: string }).username.toLowerCase() !==
+          settings.data.profile.username
+        )
+          return reply({
+            ok: false,
+            error: "Type your username to confirm.",
+            code: "validation",
+          });
+        await deps.beforeDelete(token, actor);
+      }
+      const result = await dispatchMobile(
+        deps.services(),
+        actor,
+        operation,
+        parsed.data,
+      );
+      if (guarded && key)
+        await deps.ledger.finish(actor, operation, key, result);
+      return reply(result);
+    } catch {
+      // A reserved request stays pending after an uncertain failure. Never run it
+      // twice automatically; an operator can reconcile it against stored effects.
+      return reply(
+        {
+          ok: false,
+          error:
+            "The operation could not be confirmed. Retry the same request later.",
+          code: "unavailable",
+        },
+        503,
+      );
+    }
+  };
+}
