+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { buildDemoSeedData, SEED_IDS } from "@/db/seed";
+import { createMemoryStore } from "@/db/store";
+import { createServices } from "@/domain/service";
+import { clearContextCache } from "@/domain/context-cache";
+import { mobileHandler, type MobileLedger } from "@/server/mobile-handler";
+
+function fixture() {
+  const store = createMemoryStore(buildDemoSeedData());
+  const services = createServices({ store });
+  type Row = {
+    hash: string;
+    result?: { ok: boolean; data?: unknown; error?: string; code?: string };
+  };
+  const rows = new Map<string, Row>();
+  const ledger: MobileLedger = {
+    async reserve(actor, op, key, hash) {
+      const scope = `${actor}:${op}:${key}`;
+      const prior = rows.get(scope);
+      if (!prior) {
+        rows.set(scope, { hash });
+        return { kind: "new" };
+      }
+      if (prior.hash !== hash) return { kind: "conflict" };
+      return prior.result
+        ? { kind: "replay", result: prior.result }
+        : { kind: "pending" };
+    },
+    async finish(actor, op, key, result) {
+      rows.get(`${actor}:${op}:${key}`)!.result = result;
+    },
+  };
+  const verify = vi.fn(async (token: string) =>
+    Object.values(SEED_IDS).some((id) => id === token) ? token : null,
+  );
+  const handler = mobileHandler({ verify, services: () => services, ledger });
+  async function call(
+    actor: string,
+    operation: string,
+    input: unknown = {},
+    key?: string,
+  ) {
+    const response = await handler(
+      new Request("https://fixture.test/api/mobile/v1", {
+        method: "POST",
+        headers: {
+          "Content-Type": "application/json",
+          Authorization: `Bearer ${actor}`,
+          ...(key ? { "Idempotency-Key": key } : {}),
+        },
+        body: JSON.stringify({ operation, input }),
+      }),
+    );
+    return { status: response.status, body: await response.json() };
+  }
+  return { store, services, handler, call, verify, ledger };
