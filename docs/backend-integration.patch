+-- DRAFT ONLY: generated locally; not applied to any project.
+-- Reuses the existing project. Private server-side retry tracking, no client grants.
+create table public.mobile_requests (
+  actor_id uuid not null references auth.users(id) on delete cascade,
+  operation text not null,
+  request_key text not null check (char_length(request_key) between 8 and 200),
+  input_hash text not null,
+  state text not null default 'pending' check (state in ('pending', 'complete')),
+  result jsonb,
+  created_at timestamptz not null default now(),
+  primary key (actor_id, operation, request_key),
+  check ((state = 'pending' and result is null) or (state = 'complete' and result is not null))
+);
+alter table public.mobile_requests enable row level security;
+revoke all on public.mobile_requests from public, anon, authenticated;
+grant select, insert, update, delete on public.mobile_requests to service_role;
+-- Never expire pending rows automatically: an interrupted operation may already
+-- have side effects. Reconcile them manually before any retry or removal.
+notify pgrst, 'reload schema';
