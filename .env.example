# Public Supabase credentials from the same Lonagram project the website uses.
# Copy this file to .env.local and fill in the two values.
# Expo embeds EXPO_PUBLIC_ variables in the app, so these must be the publishable or anon key.
# Never set the service-role key, OPENAI_API_KEY, SESSION_SECRET, or LONAGRAM_API_SECRET here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional alias if you copy the website's public anon key instead of the publishable key.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
